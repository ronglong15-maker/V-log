<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<title>정평중 생활중국어 - 여행 회화 종합 연습 & 모둠전</title>
<style>
  body { font-family: 'Malgun Gothic', sans-serif; background:#f4f6fb; margin:0; padding:20px; }
  h1 { text-align:center; color:#2b3a67; }
  .tabs { display:flex; justify-content:center; gap:8px; margin-bottom:20px; flex-wrap:wrap; }
  .tab-btn { padding:10px 18px; border:none; border-radius:20px; background:#dfe6f3; cursor:pointer; font-weight:bold; }
  .tab-btn.active { background:#2b3a67; color:white; }
  .category { display:none; max-width:700px; margin:0 auto; }
  .category.active { display:block; }
  .card {
    background:white; border-radius:16px; padding:25px; margin:15px 0;
    box-shadow:0 4px 10px rgba(0,0,0,0.08); text-align:center; position:relative;
  }
  .cn { font-size:24px; font-weight:bold; color:#1a1a1a; cursor:pointer; }
  .pinyin { font-size:16px; color:#5a6b9c; margin-top:6px; cursor:pointer; }
  .kr { display:none; font-size:18px; color:#d1495b; margin-top:12px; font-weight:bold; }
  .card.show .kr { display:block; }
  .blank-note { display:inline-block; margin-top:8px; font-size:12px; background:#fff3cd; color:#8a6d00; padding:3px 10px; border-radius:10px; }
  .btn-row { margin-top:14px; display:flex; justify-content:center; gap:8px; flex-wrap:wrap; }
  .speak-btn, .toggle-btn { padding:8px 14px; border:none; border-radius:20px; cursor:pointer; font-size:14px; font-weight:bold; }
  .speak-btn { background:#4caf7d; color:white; }
  .speak-btn:hover { background:#3d9c69; }
  .toggle-btn { background:#2b3a67; color:white; }
  .toggle-btn:hover { background:#1e2a4d; }
  .count-badge { position:absolute; top:12px; right:14px; background:#ffd166; color:#5a4200; font-size:12px; font-weight:bold; padding:4px 10px; border-radius:12px; }
  .extra-box { margin-top:18px; padding-top:14px; border-top:1px dashed #ccc; text-align:left; }
  .extra-title { font-size:13px; color:#999; margin-bottom:8px; font-weight:bold; }
  .extra-item { display:flex; justify-content:space-between; align-items:center; background:#f7f9fc; padding:8px 12px; border-radius:10px; margin-bottom:6px; font-size:14px; }
  .extra-item .ex-pinyin { color:#888; font-size:12px; margin-left:6px; }
  .extra-item button { background:#4caf7d; color:white; border:none; border-radius:50%; width:28px; height:28px; cursor:pointer; }
  .progress { text-align:center; margin-bottom:10px; color:#555; }
  .reset-row { text-align:center; margin-top:20px; }
  .reset-row button { background:#aaa; color:white; border:none; padding:8px 16px; border-radius:10px; cursor:pointer; }
  .total-stat { text-align:center; margin:15px 0; font-weight:bold; color:#2b3a67; font-size:16px; }

  .speed-panel {
    max-width:700px; margin:0 auto 15px auto; background:white; border-radius:14px;
    padding:14px 20px; box-shadow:0 2px 8px rgba(0,0,0,0.06);
    display:flex; align-items:center; justify-content:center; gap:10px; flex-wrap:wrap;
  }
  .speed-panel span.label { font-weight:bold; color:#2b3a67; }
  .speed-btn { padding:8px 16px; border:2px solid #2b3a67; background:white; color:#2b3a67; border-radius:20px; cursor:pointer; font-weight:bold; font-size:14px; }
  .speed-btn.active { background:#2b3a67; color:white; }
  .note-box { max-width:700px; margin:0 auto 20px auto; background:#fff8e6; border:1px solid #ffe0a3; border-radius:12px; padding:14px 18px; font-size:13px; color:#7a5c00; }
  .note-box b { color:#5a4200; }

  .quiz-box { max-width:700px; margin:20px auto; background:white; padding:25px; border-radius:16px; box-shadow:0 4px 10px rgba(0,0,0,0.08); }
  .quiz-question-cn { font-size:22px; font-weight:bold; color:#1a1a1a; text-align:center; }
  .quiz-pinyin { color:#5a6b9c; text-align:center; margin-bottom:20px; }
  .options { display:flex; flex-direction:column; gap:10px; }
  .option-btn { padding:14px; border:2px solid #dfe6f3; background:#fafbfd; border-radius:12px; cursor:pointer; font-size:15px; text-align:left; transition:0.15s; }
  .option-btn:hover { background:#eef1fa; }
  .option-btn.correct { background:#d7f5df; border-color:#4caf7d; font-weight:bold; }
  .option-btn.wrong { background:#fbdada; border-color:#d1495b; font-weight:bold; }
  .option-btn.disabled { pointer-events:none; opacity:0.85; }
  .quiz-box button.nav-btn { padding:8px 16px; border:none; background:#2b3a67; color:white; border-radius:8px; cursor:pointer; margin-top:16px; }
  .result { margin-top:12px; font-weight:bold; text-align:center; }
  .correct-text { color:green; }
  .wrong-text { color:red; }
  .score { text-align:center; font-size:18px; margin-top:15px; color:#2b3a67; font-weight:bold; }

  /* ===== 모둠전 스타일 ===== */
  .setup-box { max-width:700px; margin:20px auto; background:white; padding:25px; border-radius:16px; box-shadow:0 4px 10px rgba(0,0,0,0.08); text-align:center; }
  .setup-box input[type=number] { width:60px; padding:6px; border-radius:8px; border:1px solid #ccc; text-align:center; }
  .team-name-row { display:flex; gap:8px; align-items:center; justify-content:center; margin:8px 0; }
  .team-name-row input[type=text] { flex:1; max-width:260px; padding:8px; border-radius:8px; border:1px solid #ccc; }
  .team-color-dot { width:18px; height:18px; border-radius:50%; display:inline-block; }
  .big-btn { padding:12px 24px; background:#2b3a67; color:white; border:none; border-radius:12px; font-size:16px; font-weight:bold; cursor:pointer; margin-top:10px; }
  .big-btn:hover { background:#1e2a4d; }

  .scoreboard { max-width:900px; margin:0 auto 20px auto; display:flex; gap:12px; flex-wrap:wrap; justify-content:center; }
  .team-card {
    background:white; border-radius:16px; padding:16px 20px; min-width:140px; text-align:center;
    box-shadow:0 4px 10px rgba(0,0,0,0.08); border-top:6px solid #ccc; transition:transform 0.2s;
  }
  .team-card.turn { box-shadow:0 0 0 4px #ffd166, 0 4px 10px rgba(0,0,0,0.08); }
  .team-card .t-name { font-weight:bold; font-size:15px; margin-bottom:6px; }
  .team-card .t-score { font-size:28px; font-weight:bold; color:#2b3a67; }
  .team-card.pop { animation: popScore 0.6s ease; }
  @keyframes popScore {
    0% { transform: scale(1); }
    30% { transform: scale(1.25); }
    60% { transform: scale(0.95); }
    100% { transform: scale(1); }
  }
  .turn-badge { display:inline-block; margin-top:6px; font-size:11px; background:#ffd166; color:#5a4200; padding:2px 8px; border-radius:10px; }

  .game-arena { max-width:700px; margin:0 auto; background:white; border-radius:16px; padding:25px; box-shadow:0 4px 10px rgba(0,0,0,0.08); text-align:center; }
  .timer-circle {
    width:90px; height:90px; border-radius:50%; border:6px solid #2b3a67; margin:0 auto 14px auto;
    display:flex; align-items:center; justify-content:center; font-size:28px; font-weight:bold; color:#2b3a67;
  }
  .timer-circle.warning { border-color:#d1495b; color:#d1495b; animation: pulse 0.6s infinite; }
  @keyframes pulse { 0%{transform:scale(1);} 50%{transform:scale(1.08);} 100%{transform:scale(1);} }
  .arena-question { font-size:26px; font-weight:bold; margin:10px 0; }
  .arena-pinyin { color:#5a6b9c; margin-bottom:16px; }
  .arena-status { font-size:15px; margin:10px 0; font-weight:bold; }
  .status-turn { color:#2b3a67; }
  .status-steal { color:#d1495b; }
  .arena-btn-row { display:flex; flex-wrap:wrap; gap:10px; justify-content:center; margin-top:16px; }
  .arena-btn { padding:12px 18px; border:none; border-radius:12px; font-weight:bold; cursor:pointer; font-size:14px; }
  .btn-correct { background:#4caf7d; color:white; }
  .btn-wrong { background:#d1495b; color:white; }
  .btn-steal { background:#ffb703; color:#5a4200; }
  .btn-next { background:#2b3a67; color:white; }
  .steal-select { display:none; margin-top:14px; flex-wrap:wrap; gap:8px; justify-content:center; }
  .steal-select button { padding:8px 14px; border-radius:20px; border:2px solid #ffb703; background:#fff8e6; cursor:pointer; font-weight:bold; }
</style>
</head>
<body>

<h1>🇨🇳 정평중 생활중국어 - 여행 회화 종합 연습 & 모둠전</h1>

<div class="note-box">
  <b>📌 학습 안내</b><br>
  ① 🎚️ 발음 속도를 0.5배~1.5배 중 골라서 들어보세요.<br>
  ② "有点儿(yǒudiǎnr)"처럼 儿化音(얼화음)이 들어간 단어는 기계 음성이 다소 어색할 수 있어요. 선생님 발음이나 사전 앱도 함께 들어보세요!<br>
  ③ "_____" 빈칸이 있는 문장(예: 我叫_____, 我想去_____)은 <b>자신의 이름, 가고 싶은 장소 등을 각자 넣어서</b> 연습하세요. 퀴즈에서는 "각자의 표현 넣기"로 표시됩니다.
</div>

<div class="total-stat" id="total-stat">전체 연습 횟수: 0회</div>

<div class="speed-panel">
  <span class="label">🎚️ 발음 속도:</span>
  <button class="speed-btn" data-speed="0.5" onclick="setSpeed(0.5, this)">0.5배 (느리게)</button>
  <button class="speed-btn active" data-speed="1" onclick="setSpeed(1, this)">1배 (보통)</button>
  <button class="speed-btn" data-speed="1.5" onclick="setSpeed(1.5, this)">1.5배 (빠르게)</button>
</div>

<div class="tabs">
  <button class="tab-btn active" onclick="showTab('traffic')">🚕 교통·길찾기</button>
  <button class="tab-btn" onclick="showTab('food')">🍜 음식 주문</button>
  <button class="tab-btn" onclick="showTab('shopping')">🛍️ 물건 사기</button>
  <button class="tab-btn" onclick="showTab('vlog')">🎬 브이로그 표현</button>
  <button class="tab-btn" onclick="showTab('quiz')">✏️ 개인 퀴즈</button>
  <button class="tab-btn" onclick="showTab('team')">🏆 모둠전</button>
</div>

<div id="traffic" class="category active"></div>
<div id="food" class="category"></div>
<div id="shopping" class="category"></div>
<div id="vlog" class="category"></div>

<!-- 개인 퀴즈 -->
<div id="quiz" class="category">
  <div class="quiz-box">
    <div class="quiz-question-cn" id="quiz-question">퀴즈를 시작하려면 아래 버튼을 누르세요!</div>
    <div class="quiz-pinyin" id="quiz-pinyin"></div>
    <div class="options" id="quiz-options"></div>
    <div class="result" id="quiz-result"></div>
    <div class="score" id="quiz-score">맞춘 개수: 0 / 0</div>
    <div style="text-align:center;">
      <button class="nav-btn" onclick="initQuiz()">🔄 퀴즈 시작/다시 시작</button>
      <button class="nav-btn" id="next-btn" onclick="nextQuestion()" style="display:none;">다음 문제 ▶</button>
    </div>
  </div>
</div>

<!-- 모둠전 -->
<div id="team" class="category">

  <!-- 1) 모둠 설정 화면 -->
  <div class="setup-box" id="team-setup">
    <h2>🏆 모둠전 설정</h2>
    <p>모둠 수를 정하고, 모둠 이름을 입력하세요.</p>
    <div>
      모둠 수:
      <input type="number" id="team-count" min="2" max="8" value="4" onchange="renderTeamNameInputs()">
      <button class="big-btn" onclick="renderTeamNameInputs()" style="padding:8px 14px; font-size:13px;">모둠 수 적용</button>
    </div>
    <div id="team-name-inputs" style="margin-top:16px;"></div>
    <button class="big-btn" onclick="startTeamGame()">🚀 모둠전 시작!</button>
  </div>

  <!-- 2) 게임 화면 -->
  <div id="team-game" style="display:none;">
    <div class="scoreboard" id="scoreboard"></div>

    <div class="game-arena">
      <div class="timer-circle" id="timer-circle">15</div>
      <div class="arena-status status-turn" id="arena-status">준비 중...</div>
      <div class="arena-question" id="arena-question">-</div>
      <div class="arena-pinyin" id="arena-pinyin"></div>

      <div class="arena-btn-row" id="arena-main-btns">
        <button class="arena-btn btn-correct" onclick="markCorrect()">⭕ 정답! (+1점)</button>
        <button class="arena-btn btn-wrong" onclick="markWrongOrTimeout()">❌ 오답/시간초과 → 스틸 기회</button>
      </div>

      <div class="steal-select" id="steal-select"></div>

      <div class="arena-btn-row" id="arena-next-row" style="display:none;">
        <button class="arena-btn btn-next" onclick="nextTeamQuestion()">다음 모둠 문제 ▶</button>
      </div>
    </div>

    <div class="reset-row">
      <button onclick="endTeamGame()">🔚 모둠전 종료하고 설정으로</button>
    </div>
  </div>
</div>

<div class="reset-row">
  <button onclick="resetAllCounts()">🗑️ 전체 연습 기록 초기화</button>
</div>

<!-- 효과음 (오디오 요소) -->
<audio id="sound-correct" src="ding.mp3"></audio>
<audio id="sound-steal" src="https://actions.google.com/sounds/v1/cartoon/pop.ogg"></audio>
<audio id="sound-wrong" src="https://actions.google.com/sounds/v1/cartoon/clang_and_wobble.ogg"></audio>
<audio id="sound-tick" src="tick.mp3"></audio>
<audio id="sound-ding" src="https://actions.google.com/sounds/v1/cartoon/bell_ring.ogg"></audio>

<script>
// ============================================================
// 1. 회화 데이터 (기본 표현 + 확장 리액션 표현)
// ============================================================
const data = {
  traffic: {
    title: "교통·길찾기",
    main: [
      {id:"t1", cn:"我想去_____。", pinyin:"Wǒ xiǎng qù _____.", kr:"저는 _____에 가고 싶어요.", speakText:"我想去那里。", hasBlank:true},
