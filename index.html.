    ],
    extra: [
      {cn:"太出片了!", pinyin:"Tài chūpiàn le!", kr:"사진·영상이 정말 잘 나온다!", speakText:"太出片了!"},
      {cn:"真的很推荐!", pinyin:"Zhēn de hěn tuījiàn!", kr:"정말 추천해요!", speakText:"真的很推荐!"},
      {cn:"值得打卡!", pinyin:"Zhíde dǎkǎ!", kr:"인증하러 와 볼 만해요!", speakText:"值得打卡!"},
