      {cn:"太方便了!", pinyin:"Tài fāngbiàn le!", kr:"너무 편리하다!", speakText:"太方便了!"},
      {cn:"好快啊!", pinyin:"Hǎo kuài a!", kr:"엄청 빠르다!", speakText:"好快啊!"},
      {cn:"有点儿远。", pinyin:"Yǒudiǎnr yuǎn.", kr:"조금 머네요.", speakText:"有点远。"}
    ]
  },
  food: {
    title: "음식 주문",
    main: [
      {id:"f1", cn:"请给我菜单。", pinyin:"Qǐng gěi wǒ càidān.", kr:"메뉴판을 주세요.", speakText:"请给我菜单。"},
      {id:"f2", cn:"有什么推荐的吗?", pinyin:"Yǒu shénme tuījiàn de ma?", kr:"추천할 만한 것이 있나요?", speakText:"有什么推荐的吗?"},
      {id:"f3", cn:"我要这个。", pinyin:"Wǒ yào zhè ge.", kr:"저는 이것으로 할게요.", speakText:"我要这个。"},
