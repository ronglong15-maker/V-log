// ============================================================
// 2. 공통 - 속도 조절 / 음성 재생 / 연습 횟수
// ============================================================
let currentSpeed = 1;
function setSpeed(speed, btnEl) {
  currentSpeed = speed;
  document.querySelectorAll('.speed-btn').forEach(b => b.classList.remove('active'));
  btnEl.classList.add('active');
}

let practiceCounts = JSON.parse(localStorage.getItem('practiceCounts') || '{}');
function saveCounts() {
  localStorage.setItem('practiceCounts', JSON.stringify(practiceCounts));
  updateTotalStat();
}
function getCount(id) { return practiceCounts[id] || 0; }
function incrementCount(id) {
  practiceCounts[id] = getCount(id) + 1;
  saveCounts();
  const badge = document.getElementById('count-' + id);
  if (badge) badge.innerText = `🔁 ${practiceCounts[id]}회 연습`;
}
function updateTotalStat() {
  const total = Object.values(practiceCounts).reduce((a,b) => a+b, 0);
  document.getElementById('total-stat').innerText = `전체 연습 횟수: ${total}회`;
}
function resetAllCounts() {
  if (confirm("정말 모든 연습 기록을 초기화할까요?")) {
    practiceCounts = {};
    saveCounts();
    renderAll();
  }
}

function speak(text) {
  if (!('speechSynthesis' in window)) {
    alert('이 브라우저는 음성 재생을 지원하지 않습니다. 크롬 브라우저를 권장합니다.');
    return;
  }
  const utter = new SpeechSynthesisUtterance(text);
  utter.lang = 'zh-CN';
  utter.rate = currentSpeed;
  speechSynthesis.cancel();
  speechSynthesis.speak(utter);
}

function playSound(id) {
  const el = document.getElementById(id);
  if (el) { el.currentTime = 0; el.play().catch(()=>{}); }
}

// ============================================================
// 3. 카드 렌더링 (학습 탭)
// ============================================================
function renderCategory(key) {
  const container = document.getElementById(key);
  const catData = data[key];
  let html = `<div class="progress">카드를 클릭하면 뜻이 보이고, 🔊 버튼으로 발음을 들을 수 있어요! (속도는 상단에서 조절)</div>`;

  catData.main.forEach(item => {
    const count = getCount(item.id);
    const speakTarget = (item.speakText || item.cn).replace(/'/g, "\\'");
    html += `
      <div class="card" id="card-${item.id}">
        <div class="count-badge" id="count-${item.id}">🔁 ${count}회 연습</div>
        <div class="cn" onclick="toggleCard('${item.id}')">${item.cn}</div>
        <div class="pinyin" onclick="toggleCard('${item.id}')">${item.pinyin}</div>
        <div class="kr">${item.kr}</div>
        ${item.hasBlank ? `<div class="blank-note">✏️ 빈칸에는 자신이 원하는 이름/장소를 넣어 연습하세요!</div>` : ``}
        <div class="btn-row">
          <button class="speak-btn" onclick="speak('${speakTarget}'); incrementCount('${item.id}')">🔊 발음 듣기</button>
          <button class="toggle-btn" onclick="toggleCard('${item.id}')">👁️ 뜻 보기/숨기기</button>
        </div>
        <div class="extra-box">
          <div class="extra-title">✨ 확장 리액션 표현 (이 상황에서 써보기)</div>
          ${catData.extra.map(ex => {
            const exSpeak = (ex.speakText || ex.cn).replace(/'/g, "\\'");
            return `
            <div class="extra-item">
              <span class="ex-text">${ex.cn} <span class="ex-pinyin">${ex.pinyin} - ${ex.kr}</span></span>
              <button onclick="speak('${exSpeak}')">🔊</button>
            </div>
          `}).join('')}
        </div>
      </div>
    `;
  });
  container.innerHTML = html;
}

function toggleCard(id) {
  const card = document.getElementById('card-' + id);
  card.classList.toggle('show');
  if (card.classList.contains('show')) incrementCount(id);
}

function renderAll() {
  Object.keys(data).forEach(key => renderCategory(key));
  updateTotalStat();
}

function showTab(id) {
  document.querySelectorAll('.category').forEach(c => c.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  event.target.classList.add('active');
}

// ============================================================
// 4. 개인 퀴즈 (기본 표현만, 4지선다)
// ============================================================
let quizData = [];
let currentIndex = 0;
let correctCount = 0;
let totalCount = 0;
let answered = false;

function getAllMainSentences() {
  let all = [];
  Object.values(data).forEach(cat => {
    cat.main.forEach(item => {
      all.push({
        id: item.id, cn: item.cn, pinyin: item.pinyin,
        krDisplay: item.hasBlank ? "각자의 표현 넣기" : item.kr
      });
    });
  });
  return all;
}

function shuffle(arr) { return [...arr].sort(() => Math.random() - 0.5); }

function initQuiz() {
  quizData = shuffle(getAllMainSentences());
  currentIndex = 0; correctCount = 0; totalCount = 0;
  document.getElementById('next-btn').style.display = "none";
  showQuestion();
}

function showQuestion() {
  answered = false;
  document.getElementById('next-btn').style.display = "none";
  document.getElementById('quiz-result').innerText = "";

  if (currentIndex >= quizData.length) {
    document.getElementById('quiz-question').innerText = "🎉 모든 문제를 다 풀었어요!";
    document.getElementById('quiz-pinyin').innerText = "";
    document.getElementById('quiz-options').innerHTML = "";
    return;
  }

  const q = quizData[currentIndex];
  document.getElementById('quiz-question').innerText = q.cn;
  document.getElementById('quiz-pinyin').innerText = q.pinyin;

  const others = quizData.filter(item => item.id !== q.id && item.krDisplay !== q.krDisplay);
  const wrongChoices = shuffle(others).slice(0, 3).map(item => item.krDisplay);
  const options = shuffle([q.krDisplay, ...wrongChoices]);

  document.getElementById('quiz-options').innerHTML = options.map(opt => `
    <button class="option-btn" onclick="selectOption(this, '${opt.replace(/'/g, "\\'")}', '${q.krDisplay.replace(/'/g, "\\'")}', '${q.id}')">${opt}</button>
  `).join('');
}

function selectOption(btnEl, selected, correctAnswer, qId) {
  if (answered) return;
  answered = true;
  totalCount++;
  incrementCount(qId);

  document.querySelectorAll('.option-btn').forEach(b => {
    b.classList.add('disabled');
    if (b.innerText === correctAnswer) b.classList.add('correct');
  });

  if (selected === correctAnswer) {
    correctCount++;
    btnEl.classList.add('correct');
    document.getElementById('quiz-result').innerHTML = `<span class="correct-text">✅ 정답입니다!</span>`;
  } else {
    btnEl.classList.add('wrong');
    document.getElementById('quiz-result').innerHTML = `<span class="wrong-text">❌ 오답! 정답은 "${correctAnswer}" 입니다.</span>`;
  }
  document.getElementById('quiz-score').innerText = `맞춘 개수: ${correctCount} / ${totalCount}`;
  document.getElementById('next-btn').style.display = "inline-block";
}

function nextQuestion() { currentIndex++; showQuestion(); }

// ============================================================
// 5. 모둠전 (턴제 + 스틸 + 타이머 + 효과음/애니메이션)
// ============================================================
const TEAM_COLORS = ["#4caf7d","#2b7fd1","#d1495b","#ffb703","#8e44ad","#16a085","#e67e22","#34495e"];
let teams = [];
let teamTurnIndex = 0;
let teamQuizPool = [];
let teamCurrentQ = null;
let timerInterval = null;
let timeLeft = 15;
const TIME_LIMIT = 30;

function renderTeamNameInputs() {
  const count = parseInt(document.getElementById('team-count').value) || 4;
  let html = "";
  for (let i = 0; i < count; i++) {
    html += `
      <div class="team-name-row">
        <span class="team-color-dot" style="background:${TEAM_COLORS[i % TEAM_COLORS.length]}"></span>
        <input type="text" id="team-name-${i}" placeholder="모둠 ${i+1} 이름 입력" value="모둠 ${i+1}">
      </div>
    `;
  }
  document.getElementById('team-name-inputs').innerHTML = html;
}
renderTeamNameInputs();

function startTeamGame() {
  const count = parseInt(document.getElementById('team-count').value) || 4;
  teams = [];
  for (let i = 0; i < count; i++) {
    const nameInput = document.getElementById(`team-name-${i}`);
    const name = (nameInput && nameInput.value.trim()) ? nameInput.value.trim() : `모둠 ${i+1}`;
    teams.push({ name, score: 0, color: TEAM_COLORS[i % TEAM_COLORS.length] });
  }
  teamTurnIndex = 0;
  teamQuizPool = shuffle(getAllMainSentences());
  document.getElementById('team-setup').style.display = "none";
  document.getElementById('team-game').style.display = "block";
  renderScoreboard();
  loadNextTeamQuestion(true);
}

function endTeamGame() {
  clearInterval(timerInterval);
  stopTickSound();
  document.getElementById('team-setup').style.display = "block";
  document.getElementById('team-game').style.display = "none";
}

function renderScoreboard(popIndex = -1) {
  const board = document.getElementById('scoreboard');
  board.innerHTML = teams.map((t, i) => `
    <div class="team-card ${i === teamTurnIndex ? 'turn' : ''} ${i === popIndex ? 'pop' : ''}" style="border-top-color:${t.color}">
      <div class="t-name">${t.name}</div>
      <div class="t-score">${t.score}</div>
      ${i === teamTurnIndex ? `<div class="turn-badge">🎯 이번 턴</div>` : ``}
    </div>
  `).join('');
}

function loadNextTeamQuestion(isFirst = false) {
  stopTickSound(); // ★ 다음 문제로 넘어갈 때 틱소리 확실히 정지
  if (teamQuizPool.length === 0) teamQuizPool = shuffle(getAllMainSentences());
  teamCurrentQ = teamQuizPool.shift();
  document.getElementById('arena-question').innerText = teamCurrentQ.cn;
  document.getElementById('arena-pinyin').innerText = teamCurrentQ.pinyin;
  document.getElementById('arena-status').innerHTML =
    `<span class="status-turn">🎯 ${teams[teamTurnIndex].name} 차례입니다!</span>` +
    (teamCurrentQ.krDisplay === "각자의 표현 넣기" ? `<span style="color:#999; font-weight:normal;">(빈칸 문장: 각자의 표현으로 바꿔 말해도 정답 처리!)</span>` : "");
  document.getElementById('arena-main-btns').style.display = "flex";
  document.getElementById('steal-select').style.display = "none";
  document.getElementById('steal-select').innerHTML = "";
  document.getElementById('arena-next-row').style.display = "none";
  renderScoreboard();
  startTimer();
}

function startTimer() {
  clearInterval(timerInterval);
  stopTickSound(); // ★ 새 타이머 시작 시 이전 틱소리 정지
  timeLeft = TIME_LIMIT;
  const circle = document.getElementById('timer-circle');
  circle.innerText = timeLeft;
  circle.classList.remove('warning');
  timerInterval = setInterval(() => {
    timeLeft--;
    circle.innerText = timeLeft;
    if (timeLeft <= 10 && timeLeft > 0) {
      circle.classList.add('warning');
      playTickSound();
    }
    if (timeLeft <= 0) {
      clearInterval(timerInterval);
      stopTickSound(); // ★ 시간초과 시 정지
      markWrongOrTimeout(true);
    }
  }, 1000);
}

// ★ 틱 전용 재생 함수 (겹침 방지)
function playTickSound() {
  const el = document.getElementById('sound-tick');
  if (!el) return;
  el.pause();
  el.currentTime = 0;
  el.play().catch(()=>{});
}

// ★ 틱 사운드 정지 전용 함수
function stopTickSound() {
  const el = document.getElementById('sound-tick');
  if (el) {
    el.pause();
    el.currentTime = 0;
  }
}

// 정답 처리
function markCorrect() {
  clearInterval(timerInterval);
  stopTickSound(); // ★ 혹시 남아있는 틱소리 정지
  teams[teamTurnIndex].score += 1;
  playSound('sound-correct'); // ★ ding.mp3가 실제 연결된 id로 수정!
  renderScoreboard(teamTurnIndex);
  document.getElementById('arena-status').innerHTML = `<span class="status-turn">🎉 ${teams[teamTurnIndex].name} 정답! +1점</span>`;
  document.getElementById('arena-main-btns').style.display = "none";
  document.getElementById('arena-next-row').style.display = "flex";
  teamTurnIndex = (teamTurnIndex + 1) % teams.length;
}

// 오답/시간초과 → 스틸 기회 오픈
function markWrongOrTimeout(isTimeout = false) {
  clearInterval(timerInterval);
  stopTickSound(); // ★ 추가
  playSound('sound-wrong');
  document.getElementById('arena-status').innerHTML =
    `<span class="status-steal">${isTimeout ? "⏰ 시간 초과!" : "❌ 오답!"} 다른 모둠 스틸 찬스!</span>`;
  document.getElementById('arena-main-btns').style.display = "none";
  const stealBox = document.getElementById('steal-select');
  stealBox.style.display = "flex";
  stealBox.innerHTML = teams.map((t, i) => {
    if (i === teamTurnIndex) return "";
    return `<button style="border-color:${t.color}" onclick="stealSuccess(${i})">🙋 ${t.name} 스틸 성공!</button>`;
  }).join('') + `<button style="border-color:#aaa; background:#eee;" onclick="stealFail()">😥 아무도 못 맞힘 (턴 넘기기)</button>`;
}

function stealSuccess(index) {
  teams[index].score += 1;
  playSound('sound-steal');
  renderScoreboard(index);
  document.getElementById('arena-status').innerHTML = `<span class="status-steal">🏆 ${teams[index].name} 스틸 성공! +1점</span>`;
  document.getElementById('steal-select').style.display = "none";
  document.getElementById('arena-next-row').style.display = "flex";
  teamTurnIndex = (teamTurnIndex + 1) % teams.length;
}

function stealFail() {
  document.getElementById('arena-status').innerHTML = `<span class="status-steal">😅 아무도 못 맞혔어요. 다음 모둠으로 턴이 넘어갑니다.</span>`;
  document.getElementById('steal-select').style.display = "none";
  document.getElementById('arena-next-row').style.display = "flex";
  teamTurnIndex = (teamTurnIndex + 1) % teams.length;
}

function nextTeamQuestion() {
  loadNextTeamQuestion();
}

// ============================================================
// 초기 실행
// ============================================================
renderAll();
</script>

