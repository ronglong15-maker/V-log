      {id:"f5", cn:"买单! / 结账!", pinyin:"Mǎidān! / Jiézhàng!", kr:"계산할게요.", speakText:"买单!"}
    ],
    extra: [
      {cn:"太好吃了!", pinyin:"Tài hǎochī le!", kr:"진짜 맛있다!", speakText:"太好吃了!"},
      {cn:"好辣啊!", pinyin:"Hǎo là a!", kr:"엄청 맵다!", speakText:"好辣啊!"},
      {cn:"有点儿甜。", pinyin:"Yǒudiǎnr tián.", kr:"조금 달아요.", speakText:"有点甜。"},
      {cn:"真香!", pinyin:"Zhēn xiāng!", kr:"진짜 향기롭다(맛있어 보인다)!", speakText:"真香!"}
    ]
  },
  shopping: {
    title: "물건 사기",
    main: [
      {id:"s1", cn:"这个多少钱?", pinyin:"Zhè ge duōshao qián?", kr:"이거 얼마예요?", speakText:"这个多少钱?"},
      {id:"s2", cn:"还有别的吗?", pinyin:"Hái yǒu bié de ma?", kr:"다른 것도 있나요?", speakText:"还有别的吗?"},
