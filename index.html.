      {cn:"有点儿贵。", pinyin:"Yǒudiǎnr guì.", kr:"조금 비싸요.", speakText:"有点贵。"}
    ]
  },
  vlog: {
    title: "브이로그 표현",
    main: [
      {id:"v1", cn:"大家好！我叫_____。", pinyin:"Dàjiā hǎo! Wǒ jiào _____.", kr:"안녕하세요, 여러분! 저는 _____입니다.", speakText:"大家好！我叫小明。", hasBlank:true},
      {id:"v2", cn:"我现在在_____。", pinyin:"Wǒ xiànzài zài _____.", kr:"저는 지금 _____에 있습니다.", speakText:"我现在在北京。", hasBlank:true},
      {id:"v3", cn:"这里很漂亮!", pinyin:"Zhèlǐ hěn piàoliang!", kr:"여기 예뻐요!", speakText:"这里很漂亮!"},
